@model IEnumerable<AppUser>
@{
    ViewBag.Title = "User Management";
}

<div class="page-title">
    <i class="fas fa-users me-2"></i>User Management
</div>

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-bordered table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th><i class="fas fa-user me-1"></i>Username</th>
                    <th><i class="fas fa-envelope me-1"></i>Email</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">
                            No users found.
                        </td>
                    </tr>
                }
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            <i class="fas fa-user-circle me-2 text-primary"></i>
                            @user.UserName
                        </td>
                        <td>@user.Email</td>
                        <td class="text-center">
                            <a class="btn btn-sm btn-primary"
                                   asp-action="Edit" asp-route-id="@user.Id">
                                <i class="fas fa-edit me-1"></i>Edit
                            </a>
                            @if (!string.Equals(user.UserName, "admin",
                                     StringComparison.OrdinalIgnoreCase))
                            {
                                <form asp-action="Delete" asp-route-id="@user.Id"
                                      method="post" class="d-inline ms-1">
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Delete user @user.UserName?')">
                                        <i class="fas fa-trash me-1"></i>Delete
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Create" class="btn btn-success">
        <i class="fas fa-user-plus me-1"></i>Create User
    </a>
</div>
