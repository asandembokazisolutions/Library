<!DOCTYPE html>
<!-- Student Number: XXXXXXXX | I.Surname -->
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Library App</title>

    <!-- Bootstrap from CDN (no libman needed) -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Font Awesome from CDN -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <!-- Your custom CSS -->
    <link rel="stylesheet" href="~/css/custom.css" />
</head>
<body>

    <!-- ── Navbar ─────────────────────────────────────────────────────── -->
    <nav class="navbar navbar-expand-md navbar-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="fas fa-book-open me-2"></i>Library App
            </a>
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <!-- Left links -->
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-home me-1"></i>Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Book" asp-action="Index">
                            <i class="fas fa-books me-1"></i>Books
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="About">
                            <i class="fas fa-info-circle me-1"></i>About
                        </a>
                    </li>

                    @if (User.Identity!.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle"
                                   data-bs-toggle="dropdown" href="#">
                                <i class="fas fa-cog me-1"></i>Admin
                            </a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item"
                                       asp-controller="Admin" asp-action="Index">
                                    <i class="fas fa-users me-2"></i>User Management
                                </a>
                                <a class="dropdown-item"
                                       asp-controller="RoleAdmin" asp-action="Index">
                                    <i class="fas fa-user-shield me-2"></i>Role Management
                                </a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item"
                                       asp-controller="Genre" asp-action="Index">
                                    <i class="fas fa-tags me-2"></i>Genre Management
                                </a>
                            </div>
                        </li>
                    }
                </ul>

                <!-- Right: auth links -->
                <ul class="navbar-nav ms-auto align-items-center">
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <li class="nav-item d-flex align-items-center gap-2 px-2">
                            <img profile-user="@User.Identity.Name"
                                 class="rounded-circle"
                                 style="height:34px;width:34px;object-fit:cover;" />
                            <span class="text-white small fw-semibold">
                                Hello, @User.Identity.Name
                            </span>
                            @if (User.IsInRole("Admin"))
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="fas fa-crown me-1"></i>Admin
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    <i class="fas fa-user me-1"></i>Member
                                </span>
                            }
                        </li>
                        <li class="nav-item ms-1">
                            <form asp-controller="Account" asp-action="Logout"
                                  method="post" class="m-0">
                                <button class="btn btn-sm btn-outline-light" type="submit">
                                    <i class="fas fa-sign-out-alt me-1"></i>Log Out
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Register">
                                <i class="fas fa-user-plus me-1"></i>Register
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="fas fa-sign-in-alt me-1"></i>Log In
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- ── Main Content ───────────────────────────────────────────────── -->
    <main class="container">
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <!-- ── Footer ─────────────────────────────────────────────────────── -->
    <footer>
        <div class="container text-center">
            <p>
                <i class="fas fa-user-graduate me-1"></i>
                I.Surname &nbsp;|&nbsp; Student Number: XXXXXXXX
                &nbsp;|&nbsp; &copy; Library App @DateTime.Now.Year
            </p>
        </div>
    </footer>

    <!-- Bootstrap JS from CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>
</body>
</html>
