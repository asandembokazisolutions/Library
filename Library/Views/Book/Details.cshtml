@model Book
@{
    ViewBag.Title = Model.Title;
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-book me-2"></i>@Model.Title
            </div>
            <div class="card-body p-4">
                <dl class="row">
                    <dt class="col-sm-4"><i class="fas fa-pen me-1"></i>Author</dt>
                    <dd class="col-sm-8">@Model.Author</dd>

                    <dt class="col-sm-4"><i class="fas fa-tag me-1"></i>Genre</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-primary">@Model.Genre?.GenreName</span>
                    </dd>

                    <dt class="col-sm-4"><i class="fas fa-calendar me-1"></i>Year</dt>
                    <dd class="col-sm-8">@Model.YearPublished</dd>

                    <dt class="col-sm-4"><i class="fas fa-tag me-1"></i>Price</dt>
                    <dd class="col-sm-8 fw-bold text-success">
                        @Model.Price.ToString("C")
                    </dd>
                </dl>

                <div class="d-flex gap-2 mt-3">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to List
                    </a>
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <a asp-action="Update" asp-route-id="@Model.BookID"
                               class="btn btn-primary">
                            <i class="fas fa-edit me-1"></i>Edit
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
