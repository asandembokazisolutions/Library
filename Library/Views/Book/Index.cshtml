@model BookListViewModel
@{
    ViewBag.Title = "Books";
}

<div class="page-title">
    <i class="fas fa-book me-2"></i>Book Catalogue
</div>

<!-- Search + Filter Form -->
<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold">Search</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text" name="searchString" class="form-control"
                           placeholder="Title or author..."
                           value="@ViewData["CurrentFilter"]" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Genre</label>
                <select name="genre" class="form-select">
                    @if (ViewData["SelectedGenre"]?.ToString() == "all")
                    {
                        <option value="all" selected>All Genres</option>
                    }
                    else
                    {
                        <option value="all">All Genres</option>
                    }
                    @foreach (var g in (IEnumerable<Genre>)ViewBag.Genres)
                    {
                        if (ViewData["SelectedGenre"]?.ToString() == g.GenreName)
                        {
                            <option value="@g.GenreName" selected>@g.GenreName</option>
                        }
                        else
                        {
                            <option value="@g.GenreName">@g.GenreName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-filter me-1"></i>Filter
                </button>
                <a asp-action="Index" class="btn btn-secondary ms-1">
                    <i class="fas fa-times me-1"></i>Clear
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Books Table -->
<div class="card">
    <div class="card-body p-0">
        <table class="table table-bordered table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>
                        <a asp-action="Index"
                               asp-route-sortBy="@ViewData["TitleSortParam"]"
                               asp-route-searchString="@ViewData["CurrentFilter"]"
                               asp-route-genre="@ViewData["SelectedGenre"]">
                            <i class="fas fa-sort me-1"></i>Title
                        </a>
                    </th>
                    <th>
                        <a asp-action="Index"
                               asp-route-sortBy="@ViewData["AuthorSortParam"]"
                               asp-route-searchString="@ViewData["CurrentFilter"]"
                               asp-route-genre="@ViewData["SelectedGenre"]">
                            <i class="fas fa-sort me-1"></i>Author
                        </a>
                    </th>
                    <th>Genre</th>
                    <th>Year</th>
                    <th>
                        <a asp-action="Index"
                               asp-route-sortBy="@ViewData["PriceSortParam"]"
                               asp-route-searchString="@ViewData["CurrentFilter"]"
                               asp-route-genre="@ViewData["SelectedGenre"]">
                            <i class="fas fa-sort me-1"></i>Price
                        </a>
                    </th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Books.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="fas fa-search me-2"></i>No books found.
                        </td>
                    </tr>
                }
                @foreach (var book in Model.Books)
                {
                    <tr>
                        <td class="fw-semibold">@book.Title</td>
                        <td>@book.Author</td>
                        <td>
                            <span class="badge bg-primary">@book.Genre?.GenreName</span>
                        </td>
                        <td>@book.YearPublished</td>
                        <td>@book.Price.ToString("C")</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@book.BookID"
                                   class="btn btn-sm btn-info text-white">
                                <i class="fas fa-eye"></i>
                            </a>
                            @if (User.Identity!.IsAuthenticated)
                            {
                                <a asp-action="Update" asp-route-id="@book.BookID"
                                       class="btn btn-sm btn-primary ms-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Delete" asp-route-id="@book.BookID"
                                       class="btn btn-sm btn-danger ms-1">
                                    <i class="fas fa-trash"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Paging + Add button row -->
<div class="d-flex justify-content-between align-items-center mt-3">
    <div page-model="@Model.PagingInfo"
         page-action="Index"
         page-searchstring="@ViewData["CurrentFilter"]"
         page-classes-enabled="true"
         page-class="btn btn-sm"
         page-class-normal="btn-outline-primary"
         page-class-selected="btn-primary"
         class="d-flex gap-1">
    </div>

    @if (User.Identity!.IsAuthenticated)
    {
        <a asp-action="Add" class="btn btn-success">
            <i class="fas fa-plus me-1"></i>Add Book
        </a>
    }
</div>

<div class="text-muted small mt-2">
    Showing page @Model.PagingInfo.CurrentPage of @Model.PagingInfo.TotalPages
    (@Model.PagingInfo.TotalItems total books)
</div>
