@model IEnumerable<IdentityRole>
@{
    ViewBag.Title = "Role Management";
}

<div class="page-title">
    <i class="fas fa-user-shield me-2"></i>Role Management
</div>

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-bordered table-striped mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Role Name</th>
                    <th>Users in Role</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">
                            No roles found.
                        </td>
                    </tr>
                }
                @foreach (var role in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            <span class="badge bg-primary me-2">
                                <i class="fas fa-shield-alt"></i>
                            </span>
                            @role.Name
                        </td>
                        <td identity-role-id="@role.Id"></td>
                        <td class="text-center">
                            <a class="btn btn-sm btn-primary"
                                   asp-action="Edit" asp-route-id="@role.Id">
                                <i class="fas fa-edit me-1"></i>Edit
                            </a>
                            @if (!string.Equals(role.Name, "Admin",
                                     StringComparison.OrdinalIgnoreCase))
                            {
                                <form asp-action="Delete" asp-route-id="@role.Id"
                                      method="post" class="d-inline ms-1">
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('Delete role @role.Name?')">
                                        <i class="fas fa-trash me-1"></i>Delete
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Create" class="btn btn-success">
        <i class="fas fa-plus me-1"></i>Create Role
    </a>
</div>
