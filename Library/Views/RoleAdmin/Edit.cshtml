@model RoleEditViewModel
@{
    ViewBag.Title = "Edit Role";
}
 
<div class="bg-primary text-white p-2 mb-3 rounded">
    <h4>Edit Role: @Model.Role.Name</h4>
</div>
 
<div asp-validation-summary="All" class="text-danger mb-3"></div>
 
<form asp-action="Edit" method="post">
    <input type="hidden" name="RoleName" value="@Model.Role.Name" />
    <input type="hidden" name="RoleId" value="@Model.Role.Id" />
 
    <h6 class="bg-info text-white p-2">Add to @Model.Role.Name</h6>
    <table class="table table-bordered table-sm">
        <tbody>
            @if (!Model.NonMembers.Any())
            {
                <tr><td colspan="2">All users are already members.</td></tr>
            }
            else
            {
                foreach (var user in Model.NonMembers)
                {
                    <tr>
                        <td>@user.UserName</td>
                        <td><input type="checkbox" name="IdsToAdd" value="@user.Id" /></td>
                    </tr>
                }
            }
        </tbody>
    </table>
 
    <h6 class="bg-info text-white p-2">Remove from @Model.Role.Name</h6>
    <table class="table table-bordered table-sm">
        <tbody>
            @if (!Model.Members.Any())
            {
                <tr><td colspan="2">No members in this role.</td></tr>
            }
            else
            {
                foreach (var user in Model.Members)
                {
                    <tr>
                        <td>@user.UserName</td>
                        <td><input type="checkbox" name="IdsToDelete" value="@user.Id" /></td>
                    </tr>
                }
            }
        </tbody>
    </table>
 
    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>
